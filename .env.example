# -------------------------------------------------------------
# Local PostgreSQL Database (Docker Compose)
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_catalog
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tiktok_catalog

# -------------------------------------------------------------
# Application Ports & URLs
# -------------------------------------------------------------
PORT_VIEWER=3000
PORT_BACKOFFICE=3001
NEXT_PUBLIC_VIEWER_URL=http://localhost:3000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# -------------------------------------------------------------
# Authentication (Auth.js / NextAuth / JWT)
# -------------------------------------------------------------
AUTH_SECRET=tiktok_showcase_super_secret_jwt_token_2026

# -------------------------------------------------------------
# Cloud Database / BaaS (Supabase) - เมื่อได้ Key แล้วนำมาใส่ที่นี่
# -------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# -------------------------------------------------------------
# Cloudflare R2 Object Storage (สำหรับเก็บไฟล์รูปภาพสินค้า ไม่เสียค่า Egress)
# -------------------------------------------------------------
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=tiktok-media
# R2_PUBLIC_URL=https://media.yourdomain.com
