# -------------------------------------------------------------
# Local PostgreSQL Database (Docker Compose)
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tiktok_catalog
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=tiktok_catalog

# Schema auto-sync: defaults to true outside production, false in production.
# In production apply packages/database/migrations/*.sql instead.
# DB_SYNCHRONIZE=false

# TLS to the database is verified by default. For Supabase, download the root CA
# (Project Settings > Database > SSL) and paste the PEM here with \n line breaks.
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Last resort only (MITM-able): DB_SSL_INSECURE_SKIP_VERIFY=true

# -------------------------------------------------------------
# Application Ports & URLs
# -------------------------------------------------------------
PORT_VIEWER=3000
PORT_BACKOFFICE=3001
NEXT_PUBLIC_VIEWER_URL=http://localhost:3000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# -------------------------------------------------------------
# Authentication
# -------------------------------------------------------------
# Sessions are opaque random tokens stored (hashed) in the database: no signing
# secret is needed. Each deployment must set APP_URL to its exact public origin;
# it is used for OAuth redirect URIs and the CSRF Origin check.
# APP_URL=https://your-app.example.com

# TikTok Login Kit. Register <APP_URL>/api/auth/callback for BOTH apps
# in the TikTok developer portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# -------------------------------------------------------------
# Cloud Database / BaaS (Supabase) - เมื่อได้ Key แล้วนำมาใส่ที่นี่
# -------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# -------------------------------------------------------------
# Cloudflare R2 Object Storage (สำหรับเก็บไฟล์รูปภาพสินค้า ไม่เสียค่า Egress)
# -------------------------------------------------------------
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=tiktok-media
# R2_PUBLIC_URL=https://media.yourdomain.com   (required: uploads are served only from this domain)
